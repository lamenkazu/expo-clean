{
  "expo": {
    "name": "__APP_NAME__",
    "slug": "__APP_SLUG__",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./src/infra/shared/assets/images/icon.png",
    "scheme": "__APP_SCHEME__",
    "userInterfaceStyle": "automatic",
    "platforms": ["android"],
    "android": {
      "package": "__ANDROID_PACKAGE__",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./src/infra/shared/assets/images/android-icon-foreground.png",
        "backgroundImage": "./src/infra/shared/assets/images/android-icon-background.png",
        "monochromeImage": "./src/infra/shared/assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./src/infra/shared/assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F6F7F8",
          "dark": {
            "backgroundColor": "#1B1F22"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./src/infra/shared/assets/images/android-icon-monochrome.png",
          "color": "#2354B4"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
