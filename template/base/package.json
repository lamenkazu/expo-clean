{
  "name": "__APP_SLUG__",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "node scripts/check-native-env.js && expo run:android",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "jest",
    "test:watch": "jest --watch",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "db:generate": "drizzle-kit generate",
    "app:prebuild": "expo prebuild --platform android --no-install",
    "apk:debug": "node scripts/gradle.js assembleDebug",
    "apk:release": "node scripts/gradle.js assembleRelease",
    "aab:release": "node scripts/gradle.js bundleRelease",
    "app:update": "pnpm dlx eas-cli update --channel production",
    "doctor": "pnpm dlx expo-doctor@latest",
    "check:native": "node scripts/check-native-env.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@hookform/resolvers": "^5.9.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/analytics": "27.1.0",
    "@react-native-firebase/app": "27.1.0",
    "@react-native-firebase/crashlytics": "27.1.0",
    "@react-native-firebase/remote-config": "27.1.0",
    "drizzle-orm": "~0.45.4",
    "expo": "~58.0.16",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.13",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.5",
    "expo-router": "~58.0.24",
    "expo-splash-screen": "~58.0.10",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "expo-updates": "~58.0.17",
    "i18next": "^26.5.3",
    "nativewind": "5.0.0-rc.0",
    "react": "19.3.0",
    "react-hook-form": "^7.90.0",
    "react-i18next": "^17.1.0",
    "react-native": "0.88.1",
    "react-native-css": "3.1.0-rc.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "^5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@tailwindcss/postcss": "4.1.12",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "babel-plugin-inline-import": "^3.0.0",
    "drizzle-kit": "~0.31.11",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.11",
    "lightningcss": "1.30.1",
    "postcss": "^8.5.31",
    "tailwindcss": "4.1.12",
    "test-renderer": "^1.3.1",
    "typescript": "~7.0.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/test/setup.ts"
    ],
    "moduleNameMapper": {
      "^@core/(.*)$": "<rootDir>/src/core/$1",
      "^@infra/(.*)$": "<rootDir>/src/infra/$1",
      "^@test/(.*)$": "<rootDir>/test/$1",
      "\\.sql$": "<rootDir>/test/mocks/sql.ts"
    },
    "testMatch": [
      "<rootDir>/src/**/*.test.ts?(x)",
      "<rootDir>/test/**/*.test.ts?(x)"
    ]
  },
  "packageManager": "pnpm@11.10.0"
}
